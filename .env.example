# ===========================================================================
# Konfigurasi Docker Compose (docker-compose.yml di folder ini).
# Salin menjadi .env lalu isi nilainya. Berkas .env TIDAK PERNAH di-commit
# (sudah tercantum di .gitignore). Nama variabel sama dengan GitHub Secrets
# yang dipakai workflow deploy: APP_KEY, DB_PASSWORD, DB_ROOT_PASSWORD.
# ===========================================================================

# Kunci enkripsi Laravel. Buat dengan:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=

# Basis data MySQL. Dibaca container db (membuat database dan user saat volume
# pertama kali dibuat) dan container backend (koneksi ke host "db").
# Catatan: password hanya dibaca MySQL saat volume pertama dibuat; bila diganti
# kemudian, jalankan `docker compose down -v` (data ikut terhapus) lalu up lagi.
DB_DATABASE=todo_uts
DB_USERNAME=todo
DB_PASSWORD=ganti-password-aplikasi
DB_ROOT_PASSWORD=ganti-password-root

# Port di laptop. MySQL sengaja tidak dibuka ke laptop.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Alamat API untuk Axios, ditanam saat build image frontend (nilai publik).
VITE_API_URL=/api

# Nama dan tag image yang dibangun/ditarik Compose. Untuk memakai image hasil
# workflow deploy di GitHub Container Registry, isi misalnya:
#   BACKEND_IMAGE=ghcr.io/pbsatr25/uts-pl-24-534908-sv-24108-backend
#   FRONTEND_IMAGE=ghcr.io/pbsatr25/uts-pl-24-534908-sv-24108-frontend
#   IMAGE_TAG=sha-1234567
BACKEND_IMAGE=uts-pl-backend
FRONTEND_IMAGE=uts-pl-frontend
IMAGE_TAG=local
