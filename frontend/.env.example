# Alamat dasar API Laravel yang dipakai Axios (src/lib/http.js).
# Nilai ini ditanam ke hasil build saat `npm run build`, jadi tidak ada alamat API
# yang ditulis mati di komponen.
#
#   npm run dev : /api diteruskan proxy Vite ke http://127.0.0.1:8000 (vite.config.js)
#   Docker      : /api diteruskan Nginx ke service backend
#   CI          : diisi dari GitHub Actions variable VITE_API_URL
VITE_API_URL=/api
